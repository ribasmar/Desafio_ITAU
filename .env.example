# ──────────────────────────────────────────────────────────────
# CopomLens — Configuração do LLM
# Copie para .env e edite conforme necessário.
# ──────────────────────────────────────────────────────────────

# Provider: "local" (llama.cpp) ou "openrouter"
LLM_PROVIDER=local

# ── Local (llama.cpp) ─────────────────────────────────────────
# Inicie o servidor:
#   LD_LIBRARY_PATH=./llama.cpp/bin ./llama.cpp/bin/llama-server \
#     -m ./Qwen2.5-14B-Instruct-Q5_K_M.gguf \
#     --host 127.0.0.1 --port 8080 \
#     -c 32768 --cache-ram 0 -sps 0.0 -np 1 -ngl 99
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLM_MODEL_LOCAL=Qwen2.5-14B-Instruct-Q5_K_M.gguf

# ── OpenRouter ───────────────────────────────────────────────
# Para usar modelos via API (ex.: Qwen3-32B):
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#   LLM_MODEL_OPENROUTER=qwen/qwen-3-32b
#   OPENROUTER_PROVIDER=Groq

# ── Prompt ───────────────────────────────────────────────────
PROMPT_PATH=./prompts/copom_v3.md

# ── Reprodutibilidade ─────────────────────────────────────────
SEED=42
TEMPERATURE=0.0
